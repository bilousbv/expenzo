# Copy to .env and fill from `pnpm db:status` (or `supabase status -o env`).
#
# Metro string-replaces EXPO_PUBLIC_* at build time, which means the reference
# must appear literally in the source: `process.env.EXPO_PUBLIC_SUPABASE_URL`.
# Destructuring process.env does not work.
#
# A physical device cannot reach 127.0.0.1 — use your machine's LAN address
# there, e.g. http://192.168.1.20:54421.
#
# Port 54421, not the Supabase default of 54321 — see supabase/config.toml.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Third-party sign-in. These only decide whether the button is rendered; the
# provider itself is turned on in supabase/config.toml. Leave them unset until
# real credentials exist, or the button will be there and can only fail.
# EXPO_PUBLIC_ENABLE_GOOGLE_AUTH=true
# EXPO_PUBLIC_ENABLE_APPLE_AUTH=true
