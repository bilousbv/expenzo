# Copy to .env.local and fill from `pnpm db:status` (or `supabase status -o env`).
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time and are
# public by definition. Never put a secret behind that prefix.

# Port 54421, not the Supabase default of 54321 — see supabase/config.toml.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security entirely, so it must never be
# prefixed NEXT_PUBLIC_ and must never be imported into a client component.
# Used by the Playwright auth setup project to create its test user, and by the
# exchange-rate sync, which writes reference data no household owns.
SUPABASE_SERVICE_ROLE_KEY=

# The shared secret POST /api/fx/sync requires, sent as `Authorization: Bearer`.
# Unset means the route refuses everything — it never means "no check".
#
# In production a scheduler calls that route once a day, after the European
# Central Bank publishes at around 16:00 CET; re-running it is free. Locally
# there is no scheduler: supabase/seed.sql puts a fortnight of plausible rates
# in the table so foreign-currency expenses can be entered offline.
#
#   curl -X POST http://127.0.0.1:3000/api/fx/sync -H "Authorization: Bearer $FX_SYNC_SECRET"
FX_SYNC_SECRET=

# Playwright's test account, created via the admin API on first run.
# At least 8 characters — see minimum_password_length in supabase/config.toml.
E2E_TEST_EMAIL=e2e@expenzo.test
E2E_TEST_PASSWORD=

# Third-party sign-in. These only decide whether the button is rendered; the
# provider itself is turned on in supabase/config.toml, where `enabled` cannot
# be read from the environment. Leave them unset until real credentials exist,
# or the button will be there and can only fail.
#
# Google: create an OAuth client at console.cloud.google.com, authorised
# redirect URI http://127.0.0.1:54421/auth/v1/callback.
# Apple: a Services ID and a signed JWT secret from developer.apple.com.
# NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true
# NEXT_PUBLIC_ENABLE_APPLE_AUTH=true

# The credentials themselves are not read from this file. The Supabase CLI
# substitutes the env() references in supabase/config.toml from a .env at the
# repo root, and looks nowhere else — see the .env there.
