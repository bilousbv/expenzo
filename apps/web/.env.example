# Copy to .env.local and fill from `pnpm db:status` (or `supabase status -o env`).
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time and are
# public by definition. Never put a secret behind that prefix.

# Port 54421, not the Supabase default of 54321 — see supabase/config.toml.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security entirely, so it must never be
# prefixed NEXT_PUBLIC_ and must never be imported into a client component.
# Used by the Playwright auth setup project to create its test user.
SUPABASE_SERVICE_ROLE_KEY=

# Playwright's test account, created via the admin API on first run.
E2E_TEST_EMAIL=e2e@expenzo.test
E2E_TEST_PASSWORD=
